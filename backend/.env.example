# Port the Express API listens on
PORT=5000

# Stellar network profile as registered with the stellar CLI (local | testnet | mainnet)
STELLAR_NETWORK=local

# Identity the backend signs transactions with (`stellar keys ls`)
STELLAR_SOURCE_ACCOUNT=alice

# Deployed contract addresses (see README > Deploying the contracts)
VAULT_CONTRACT_ID=
VERIFIER_CONTRACT_ID=

# Optional: absolute paths to the toolchain. Resolved from PATH when unset.
# NARGO_BIN=/home/you/.nargo/bin/nargo
# BB_BIN=/home/you/.bb/bin/bb
# STELLAR_BIN=stellar

# Optional: override the circuit package location
# CIRCUIT_DIR=../circuits/ownership_vault
